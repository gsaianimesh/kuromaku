# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres. Create a project at https://neon.tech, then copy both strings.
# DATABASE_URL is the *pooled* host (…-pooler.…), used by the app.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED is the *direct* host, used by drizzle-kit migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes every stored BYOK key undecryptable, so keep it stable.
APP_ENCRYPTION_KEY=""

# Dev-only fallback for model calls. In production, keys come from the BYOK
# settings screen and are stored encrypted per workspace.
GROQ_API_KEY=""
ANTHROPIC_API_KEY=""
